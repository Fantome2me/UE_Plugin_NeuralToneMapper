{
	"FileVersion": 3,
	"Version": 105,
	"VersionName": "1.0.5",
	"FriendlyName": "Neural Tone Mapper (AI 动态色调映射)",
	"Description": "Replaces Unreal Engine's built-in tone mapping with a hardware-aware, LUT-backed tone mapper whose tone curve AND local Laplacian filter strengths are predicted every frame by a small neural network (327K parameters) running through NNE on the GPU. The curve adapts to scene content and to the display's real peak / ABL-limited luminance, and supports SDR, Rec.709, PQ (ST.2084) and scRGB output. Toggled from the editor's Build menu or with r.NTMO.Enable.",
	"Category": "Rendering",
	"CreatedBy": "",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EngineVersion": "5.8.0",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"SupportedTargetPlatforms": [
		"Win64"
	],
	"Modules": [
		{
			"Name": "NeuralToneMapper",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit"
		},
		{
			"Name": "NeuralToneMapperEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		}
	],
	"Plugins": [
		{
			"Name": "NNERuntimeRDG",
			"Enabled": true,
			"Optional": true
		}
	]
}
