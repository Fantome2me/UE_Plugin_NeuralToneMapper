{
	"FileVersion": 3,
	"Version": 115,
	"VersionName": "1.1.4",
	"FriendlyName": "Neural Tone Mapper (AI 动态色调映射)",
	"Description": "Replaces Unreal Engine's built-in tone mapping with a LUT-backed tone mapper. A compact NNE neural network predicts the global tone curve from display context and local Laplacian parameters from scene statistics. Supports SDR, Rec.709, PQ (ST.2084) and scRGB output. Toggled from the editor's Build menu or with r.NTMO.Enable.",
	"Category": "Rendering",
	"CreatedBy": "",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EngineVersion": "5.8.0",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"Installed": true,
	"SupportedTargetPlatforms": [
		"Win64"
	],
	"Modules": [
		{
			"Name": "NeuralToneMapper",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit"
		},
		{
			"Name": "NeuralToneMapperEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		}
	],
	"Plugins": [
		{
			"Name": "NNERuntimeORT",
			"Enabled": true
		},
		{
			"Name": "NNERuntimeRDG",
			"Enabled": true,
			"Optional": true
		}
	]
}