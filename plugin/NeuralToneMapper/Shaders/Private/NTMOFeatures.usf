//
// Builds the 48-channel input tensor that the trained curve network consumes:
//
//   channel  0.. 2  scene colour, PQ encoded, quantised to 8 bit / 255, at 128x72
//   channel  3..15  display / scene scalars (13)
//   channel 16..31  4x4 tile means of log2 luminance (16)
//   channel 32..47  16-bin log2 luminance histogram (16)
//
// Channels 3..47 are constant across the image, exactly as assemble_tensor_torch()
// broadcasts them in training. Replicating them over 72x128 wastes ~1.6 MB of the
// 1.77 MB buffer but keeps the GPU tensor bit-identical to the training contract,
// which is worth far more than that bandwidth.
//
// INTEGER ATOMICS, NOT FLOAT
// -------------------------
// HLSL has no InterlockedAdd for float, so the statistics buffer is uint and the
// log2 values are carried in fixed point: (LogLum + 16) * 256. Range check: LogLum is
// clamped to roughly [-14, 8], so the encoded value is in [512, 6144]; summing even
// 4K/64 = 130k pixels stays below 8e8, comfortably inside uint32. The quantisation
// step is 1/256 of a stop, and these are means over thousands of pixels, so the
// error averages out.
//
// IMPORTANT: the python reference for this file is pack_sample() in ntmo_pack.py.
// Two small deviations are deliberate and documented below (mean-of-log2 for tiles,
// and a top-bin approximation for p99.99).

#include "NTMOCommon.ush"

#define NTMO_FEAT_GROUP 8

// Layout of the statistics buffer (uint, 34 entries).
#define NTMO_STAT_SUMLOG   0		// encoded sum of log2 luminance
#define NTMO_STAT_COUNT    1		// pixel count
#define NTMO_STAT_TILE     2		// 16 entries: 2..17, encoded sums per tile
#define NTMO_STAT_BIN      18		// 16 entries: 18..33, histogram counts
#define NTMO_STAT_TOTAL    34

#define NTMO_STAT_SCALE    256.0f
#define NTMO_STAT_OFFSET   16.0f

// Layout of the scalar context that the game thread fills (13 entries, same order
// as ntmo_pack.pack_sample). Entries 0 and 1 are placeholders: the real log2_mean and
// log2_p9999 are derived from the GPU statistics instead, because the CPU has no way
// to know them without a readback.
#define NTMO_CTX_SCALARS   13

float NTMO_PQEncodeLocal(float NitsLinear)
{
	// SMPTE ST 2084, matching ntmo_pack.linear_to_pq().
	const float M1 = 0.1593017578125f;
	const float M2 = 78.84375f;
	const float C1 = 0.8359375f;
	const float C2 = 18.8515625f;
	const float C3 = 18.6875f;
	float Y = saturate(NitsLinear);
	float Ym1 = pow(Y, M1);
	return pow((C1 + C2 * Ym1) / (1.0f + C3 * Ym1), M2);
}

float NTMO_Log2Lum4(float3 LinearColor)
{
	float L = dot(max(LinearColor, 0.0f), float3(0.2126f, 0.7152f, 0.0722f));
	return log2(max(L, 1e-7f));
}

uint NTMO_EncodeLog(float LogLum)
{
	// Clamped to the histogram range so the encoding can never wrap.
	float C = clamp(LogLum, -14.0f, 8.0f);
	return (uint)round((C + NTMO_STAT_OFFSET) * NTMO_STAT_SCALE);
}

float NTMO_DecodeLogSum(uint Encoded)
{
	return (float)Encoded / NTMO_STAT_SCALE - NTMO_STAT_OFFSET;
}

// ---------------------------------------------------------------------------
// Pass 1: reduce a coarse log2-luminance texture into tiles + histogram
// ---------------------------------------------------------------------------
Texture2D<float> NTMOStatsLum;
SamplerState NTMOStatsLumSampler;
RWStructuredBuffer<uint> RWNTMOStats;
uint NTMOStatsWidth;
uint NTMOStatsHeight;

[numthreads(NTMO_FEAT_GROUP, NTMO_FEAT_GROUP, 1)]
void MainCS_SceneStats(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint2 P = DispatchThreadId.xy;
	if (P.x >= NTMOStatsWidth || P.y >= NTMOStatsHeight)
	{
		return;
	}

	float2 UV = (float2(P) + 0.5f) * float2(1.0f / NTMOStatsWidth, 1.0f / NTMOStatsHeight);
	float LogLum = NTMOStatsLum.SampleLevel(NTMOStatsLumSampler, UV, 0);
	LogLum = clamp(LogLum, -14.0f, 8.0f);

	const uint Encoded = NTMO_EncodeLog(LogLum);

	// 4x4 tiles, same ordering as ntmo_pack.pack_sample().
	const uint tx = min(3u, (uint)(UV.x * 4.0f));
	const uint ty = min(3u, (uint)(UV.y * 4.0f));
	InterlockedAdd(RWNTMOStats[NTMO_STAT_TILE + ty * 4 + tx], Encoded);

	// 16 log2 bins over [-14, 8], matching ntmo_pack's histogram_edges.
	const uint Bin = min(15u, (uint)floor(saturate((LogLum + 14.0f) / 22.0f) * 15.0f + 0.5f));
	InterlockedAdd(RWNTMOStats[NTMO_STAT_BIN + Bin], 1u);

	InterlockedAdd(RWNTMOStats[NTMO_STAT_SUMLOG], Encoded);
	InterlockedAdd(RWNTMOStats[NTMO_STAT_COUNT], 1u);
}

// ---------------------------------------------------------------------------
// Pass 2: assemble the network input tensor
// ---------------------------------------------------------------------------
Texture2D NTMOSceneColorFeat;
SamplerState NTMOSceneColorFeatSampler;

StructuredBuffer<uint> NTMOStats;
StructuredBuffer<float> NTMOCtxScalars;
RWStructuredBuffer<float> RWNTMOInputTensor;

// 1/2-res log2 luminance, used only to derive the edge channel.
Texture2D<float> NTMOGuideTex;
SamplerState NTMOGuideTexSampler;
float2 NTMOGuideTexelSize;

uint NTMOFeatW;
uint NTMOFeatH;
uint NTMOFeatPlane;

[numthreads(NTMO_FEAT_GROUP, NTMO_FEAT_GROUP, 1)]
void MainCS_Assemble(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint2 P = DispatchThreadId.xy;
	if (P.x >= NTMOFeatW || P.y >= NTMOFeatH)
	{
		return;
	}

	const float2 UV = (float2(P) + 0.5f) * float2(1.0f / NTMOFeatW, 1.0f / NTMOFeatH);
	const uint Base = P.y * NTMOFeatW + P.x;

	const float Count = max((float)NTMOStats[NTMO_STAT_COUNT], 1.0f);

	// --- channels 0..2: PQ encoded, quantised to 8 bit ---------------------
	float3 Lin = max(NTMOSceneColorFeat.SampleLevel(NTMOSceneColorFeatSampler, UV, 0).rgb, 0.0f);
	float3 Pq = NTMO_PQEncodeLocal(Lin * 100.0f);		// 1.0 linear == 100 nits
	[unroll] for (uint c = 0; c < 3; ++c)
	{
		const float Q = floor(saturate(Pq[c]) * 255.0f + 0.5f) / 255.0f;
		RWNTMOInputTensor[c * NTMOFeatPlane + Base] = Q;
	}

	// --- channel 3: EDGE MAGNITUDE -----------------------------------------
	// This is the paper's "conditioned on a Canny edge map": the network needs to know
	// where the strong edges are, because that is what decides how hard the local
	// Laplacian filter may push before halos appear. Sobel on the 1/2-res log2
	// luminance, exactly as ntmo_local.edge_channel() computes it during training.
	{
		const float2 T = NTMOGuideTexelSize;
		float l00 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2(-1, -1), 0);
		float l10 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2( 0, -1), 0);
		float l20 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2( 1, -1), 0);
		float l01 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2(-1,  0), 0);
		float l21 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2( 1,  0), 0);
		float l02 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2(-1,  1), 0);
		float l12 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2( 0,  1), 0);
		float l22 = NTMOGuideTex.SampleLevel(NTMOGuideTexSampler, UV + T * float2( 1,  1), 0);

		const float Gx = (l20 + 2.0f * l21 + l22) - (l00 + 2.0f * l01 + l02);
		const float Gy = (l02 + 2.0f * l12 + l22) - (l00 + 2.0f * l10 + l20);
		const float Mag = sqrt(Gx * Gx + Gy * Gy);

		// 3 stops of log2 difference per pixel is already a very strong edge.
		RWNTMOInputTensor[3 * NTMOFeatPlane + Base] = saturate(Mag / 3.0f);
	}

	// --- channel 4: log2 mean luminance (derived from the GPU statistics) ---
	// pack_sample uses log2(mean_lum); we have the mean of log2. For a 1/8-res level
	// of a natural image the two agree to well under the 1/16 normalisation step, and
	// mean-of-log2 is the better behaved statistic across specular highlights.
	const float MeanLog = NTMO_DecodeLogSum(NTMOStats[NTMO_STAT_SUMLOG]) / Count;
	RWNTMOInputTensor[4 * NTMOFeatPlane + Base] = clamp(MeanLog / 16.0f, -1.0f, 1.0f);

	// --- channel 5: log2 p99.99 luminance -----------------------------------
	// Not computable from a 16-bin histogram exactly, so use the upper edge of the
	// highest occupied bin. p99.99 only moves the shoulder, so a bin-resolution
	// estimate (1.375 stops) is adequate and always monotone in the data.
	float P9999Log = -14.0f;
	[unroll] for (int b = 15; b >= 0; --b)
	{
		if (NTMOStats[NTMO_STAT_BIN + (uint)b] > 0u && P9999Log < -13.0f)
		{
			P9999Log = -14.0f + 22.0f * ((float)b + 1.0f) / 16.0f;
		}
	}
	RWNTMOInputTensor[5 * NTMOFeatPlane + Base] = clamp(P9999Log / 16.0f, -1.0f, 1.0f);

	// --- channels 6..16: the remaining display/scene scalars ----------------
	[unroll] for (uint s = 2; s < NTMO_CTX_SCALARS; ++s)
	{
		RWNTMOInputTensor[(4 + s) * NTMOFeatPlane + Base] = NTMOCtxScalars[s];
	}

	// --- channels 17..32: tile means ---------------------------------------
	const float PerTile = max(Count * (1.0f / 16.0f), 1.0f);
	[unroll] for (uint t = 0; t < 16; ++t)
	{
		const float TileMeanLog = NTMO_DecodeLogSum(NTMOStats[NTMO_STAT_TILE + t]) / PerTile;
		RWNTMOInputTensor[(17 + t) * NTMOFeatPlane + Base] = clamp(TileMeanLog / 16.0f, -1.0f, 1.0f);
	}

	// --- channels 33..48: histogram ---------------------------------------
	[unroll] for (uint hb = 0; hb < 16; ++hb)
	{
		const float Frac = (float)NTMOStats[NTMO_STAT_BIN + hb] / Count;
		RWNTMOInputTensor[(33 + hb) * NTMOFeatPlane + Base] = Frac;
	}
}
