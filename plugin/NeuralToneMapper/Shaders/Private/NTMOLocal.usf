//
// Local operator: half-resolution Laplacian pyramid + low-frequency guide gain.
//
// WHY A HALF-RESOLUTION PYRAMID
// ----------------------------
// A full-resolution Laplacian pyramid at 4K costs ~0.38 ms PER full-res pass in pure
// bandwidth (8.29 Mpix * 8B * read+write / ~350 GB/s). Two such passes (build +
// reconstruct) already blow the budget, and dropping pyramid levels does not help:
// the finest level is 94% of the cost, so 4 levels -> 2 levels saves 1.6%. The only
// levers that matter are (a) put the finest level at half resolution, and (b) emit a
// small gain map consumed by the EXISTING tonemap pass, so there is no extra
// full-resolution pass at all.
//
// PYRAMID (single channel, log2 luminance)
// ---------------------------------------
//   G0 = log2 lum at 1/2 res      G1 = down(G0)  1/4
//   G2 = down(G1)  1/8            G3 = down(G2)  1/16   <- very coarse reference
//
//   L0 = G0 - G1   mid-frequency band
//   L1 = G1 - G2   low-frequency band
//   Low = G1 - G3  deviation from the very coarse local mean  -> local exposure (D1)
//
//   log2(gain) = LowStrength * Low + Det0 * L0 + Det1 * L1
//
// Using G3 as the adaptation reference instead of a global frame mean avoids a
// full-frame reduction (two extra dispatches + a sync) and is closer to bilateral
// local exposure anyway, because the reference is spatially varying.
//
// The gain is a SMOOTH low-frequency quantity clamped to [0.25, 4.0], so bilinear
// upsampling in the tonemapper cannot produce halos. Halos only appear when a
// high-contrast RATIO is upsampled, which this formulation avoids by construction.
//
// With all three strengths at 0 the gain is exactly 1.0 and the LUT path is
// bit-identical to the previous behaviour.

#include "NTMOCommon.ush"

#define NTMO_LOCAL_GROUP 8
#define NTMO_LOCAL_MAX_LEVELS 4

float NTMO_Log2LuminanceOf(float3 LinearColor)
{
	// Rec.709 luminance; 1.0 linear == 100 nits by project convention.
	float L = dot(max(LinearColor, 0.0f), float3(0.2126f, 0.7152f, 0.0722f));
	return log2(max(L, 1e-7f));
}

/** 2x2 box downsample of a single-channel texture. Texel size is passed explicitly. */
float NTMO_Box2x2(Texture2D<float> Src, SamplerState Samp, float2 UV, float2 SrcTexel)
{
	float2 O = SrcTexel * 0.25f;
	float S = 0.0f;
	S += Src.SampleLevel(Samp, UV + float2(-O.x, -O.y), 0);
	S += Src.SampleLevel(Samp, UV + float2( O.x, -O.y), 0);
	S += Src.SampleLevel(Samp, UV + float2(-O.x,  O.y), 0);
	S += Src.SampleLevel(Samp, UV + float2( O.x,  O.y), 0);
	return S * 0.25f;
}

// ---------------------------------------------------------------------------
// Pass 1: full-res scene colour -> G0 (half-res log2 luminance)
// ---------------------------------------------------------------------------
Texture2D NTMOSceneColorLocal;
SamplerState NTMOSceneColorLocalSampler;
float2 NTMOSceneColorTexelSize;
RWTexture2D<float> RWNTMOG0;

[numthreads(NTMO_LOCAL_GROUP, NTMO_LOCAL_GROUP, 1)]
void MainCS_LumFromScene(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint W, H;
	RWNTMOG0.GetDimensions(W, H);
	if (DispatchThreadId.x >= W || DispatchThreadId.y >= H)
	{
		return;
	}

	// Box filter 2x2 full-resolution samples; point sampling would alias the pyramid
	// on high-contrast edges.
	float2 Base = (float2(DispatchThreadId.xy) + 0.5f) * NTMOSceneColorTexelSize * 2.0f;
	float2 T = NTMOSceneColorTexelSize;
	float Sum = 0.0f;
	[unroll] for (int y = 0; y < 2; ++y)
	{
		[unroll] for (int x = 0; x < 2; ++x)
		{
			float2 UV = Base + float2(x, y) * T;
			float3 C = NTMOSceneColorLocal.SampleLevel(NTMOSceneColorLocalSampler, UV, 0).rgb;
			Sum += NTMO_Log2LuminanceOf(C);
		}
	}
	RWNTMOG0[DispatchThreadId.xy] = Sum * 0.25f;
}

// ---------------------------------------------------------------------------
// Pass 2: G(n) -> G(n+1), single channel, box 2x2
// ---------------------------------------------------------------------------
Texture2D<float> NTMOLevelIn;
SamplerState NTMOLevelInSampler;
float2 NTMOLevelInTexelSize;
RWTexture2D<float> RWNTMOLevelOut;

[numthreads(NTMO_LOCAL_GROUP, NTMO_LOCAL_GROUP, 1)]
void MainCS_Downsample(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint W, H;
	RWNTMOLevelOut.GetDimensions(W, H);
	if (DispatchThreadId.x >= W || DispatchThreadId.y >= H)
	{
		return;
	}
	float2 UV = (float2(DispatchThreadId.xy) + 0.5f) * float2(1.0f / W, 1.0f / H);
	RWNTMOLevelOut[DispatchThreadId.xy] =
		NTMO_Box2x2(NTMOLevelIn, NTMOLevelInSampler, UV, NTMOLevelInTexelSize);
}

// ---------------------------------------------------------------------------
// Pass 3: LEARNED local Laplacian correction (NTM 1.0.2)
//
// This replaces the three hand-tuned strengths (0.60 / 0.25 / 0.10) with a 4x4 map of
// per-band strengths predicted by the network, applied as a Durand base/detail split:
//
//   corr = s_base * (curve(base) - curve(logY))    nonlinear base compression
//        + s_mid  * (G1 - G3)                      coarse band
//        + s_high * (G0 - G1)                      fine band
//
// two things matter here:
//
// 1) corr is a DISPLAY-REFERRED log2 offset, added AFTER the tone curve (the tonemap
//    shader multiplies by exp2(corr)). The previous version multiplied the scene
//    BEFORE the curve, so any detail the local operator restored was immediately
//    re-compressed by the curve's shoulder -- which is exactly the "detail boost but
//    the highlights still look flat" failure mode.
//
// 2) the strengths are spatially varying and learned, so a bright window and a dark
//    corner can ask for different amounts of local work. That is the LLF parameter map
//    from the paper (it predicted it with a lightweight network too).
// ---------------------------------------------------------------------------
Texture2D<float> NTMOLum0;		// 1/2   log2 luminance
SamplerState NTMOLum0Sampler;
Texture2D<float> NTMOLum1;		// 1/4
SamplerState NTMOLum1Sampler;
Texture2D<float> NTMOLum2;		// 1/8
SamplerState NTMOLum2Sampler;
Texture2D<float> NTMOLum3;		// 1/16  = the base layer of the decomposition
SamplerState NTMOLum3Sampler;
// R = scene-referred gain in stops, applied BEFORE the tone curve.
// G = display-referred offset in stops, applied AFTER the tone curve.
//
// Why two channels and two domains: a local-exposure gain has to act on scene
// luminance, because that is what it physically is. Applied before the curve it also
// gets amplified by the curve's steep toe, which is exactly why v1.0.1 opened shadows
// visibly. A detail restoration, on the other hand, has to act after the curve or the
// curve simply re-compresses it. NTM 1.0.2/1.0.3 put everything after the curve, so
// dark areas -- where display code values are small -- barely moved.
RWTexture2D<float2> RWNTMOCorrection;

// The network's whole output: [0..7] curve knots, [8..55] the 4x4x3 strengths.
StructuredBuffer<float> NTMONeuralOut;

/** 1.5: de-normalises the label from [-1,1] back to stops of band strength. */
float NTMOStrengthScale;
/**
 * How much of the three DETAIL bands (0..2) to apply. 0 keeps only the local-exposure
 * band, 1 applies everything.
 *
 * Why this exists: bands 0..2 are fitted to reproduce Durand's "compress the base and
 * add the full detail back", which is a brightening operator by construction. Measured
 * with all four bands, the correction lifted the whole frame by +0.16 display luma
 * (+0.2..+0.48 stops in most tiles) and the image washed out. The local-exposure band
 * is the one that behaves like real local tone mapping (dark regions up, bright regions
 * down), so the default keeps the detail bands at a quarter strength.
 */
float NTMODetailMix;
float NTMOExposureScale;

// 1.0.7: the shadow lift existed but was ineffective. Measured on the night-sky scene:
// s_low ~0.2, exposure scale 0.5, a region 1 stop below the mean gave
// 1 * 0.2 * 0.5 = 0.1 stops of lift - invisible. This multiplies it into a range where
// dark regions actually open up (2 stops below the mean -> ~0.6 stops at 3x).
float NTMOShadowBoost;
/** Hard safety clamp on the correction, in stops. */
float NTMOClampStops;

#define NTMO_LOCAL_TILES 4
#define NTMO_LOCAL_BANDS 4

// Frame log2-luminance statistics, shared with the feature-assembly pass.
// Only the mean is needed here: the local-exposure band is defined relative to it.
StructuredBuffer<uint> NTMOStatsBuf;
#define NTMO_STAT_SUMLOG_I 0
#define NTMO_STAT_COUNT_I  1
#define NTMO_STAT_SCALE_F  256.0f
#define NTMO_STAT_OFFSET_F 16.0f

float NTMO_MeanLogLum()
{
	const float Count = max((float)NTMOStatsBuf[NTMO_STAT_COUNT_I], 1.0f);
	// Each pixel contributed (log2Lum + 16) * 256, so undo both the scale and the bias.
	return ((float)NTMOStatsBuf[NTMO_STAT_SUMLOG_I] / NTMO_STAT_SCALE_F) / Count - NTMO_STAT_OFFSET_F;
}

float NTMO_CurveAt(float LogX)
{
	FNTMOKnots K;
	K.K01 = float4(NTMONeuralOut[0], NTMONeuralOut[1], NTMONeuralOut[2], NTMONeuralOut[3]);
	K.K23 = float4(NTMONeuralOut[4], NTMONeuralOut[5], NTMONeuralOut[6], NTMONeuralOut[7]);
	return NTMO_EvalCurveLog2(LogX, K);
}

/**
 * Bilinear fetch of the 4x4 strength grid.
 *
 * The map is only 4x4, so nearest-tile sampling would show visible tile seams on a
 * smooth gradient. Interpolating between tile centres costs 4 buffer loads and removes
 * them entirely -- cheaper than storing a larger map.
 */
float NTMO_ParamAt(float2 UV, int Band)
{
	float2 T = UV * (float)NTMO_LOCAL_TILES - 0.5f;
	float2 F = frac(T);
	int2 I0 = (int2)floor(T);
	float Acc = 0.0f;

	[unroll] for (int y = 0; y < 2; ++y)
	{
		[unroll] for (int x = 0; x < 2; ++x)
		{
			int2 C = clamp(I0 + int2(x, y), int2(0, 0), int2(NTMO_LOCAL_TILES - 1, NTMO_LOCAL_TILES - 1));
			const float W = ((x == 0) ? (1.0f - F.x) : F.x) * ((y == 0) ? (1.0f - F.y) : F.y);
			Acc += W * NTMONeuralOut[8 + (C.y * NTMO_LOCAL_TILES + C.x) * NTMO_LOCAL_BANDS + Band];
		}
	}
	return Acc;
}

[numthreads(NTMO_LOCAL_GROUP, NTMO_LOCAL_GROUP, 1)]
void MainCS_Correction(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint W, H;
	RWNTMOCorrection.GetDimensions(W, H);
	if (DispatchThreadId.x >= W || DispatchThreadId.y >= H)
	{
		return;
	}

	const float2 UV = (float2(DispatchThreadId.xy) + 0.5f) * float2(1.0f / W, 1.0f / H);

	const float G0 = NTMOLum0.SampleLevel(NTMOLum0Sampler, UV, 0);
	const float G1 = NTMOLum1.SampleLevel(NTMOLum1Sampler, UV, 0);
	const float G3 = NTMOLum3.SampleLevel(NTMOLum3Sampler, UV, 0);

	const float SBase = NTMO_ParamAt(UV, 0) * NTMOStrengthScale;
	const float SMid  = NTMO_ParamAt(UV, 1) * NTMOStrengthScale;
	const float SHigh = NTMO_ParamAt(UV, 2) * NTMOStrengthScale;
	const float SLow  = NTMO_ParamAt(UV, 3) * NTMOStrengthScale;

	// The curve has to be evaluated at both the fine luminance and the base luminance:
	// curve(base) is the compressed base, curve(logY) is what the global-only path
	// already did, so their difference is the base correction Durand asks for.
	const float C0 = NTMO_CurveAt(G0);
	const float C3 = NTMO_CurveAt(G3);

	// Terms 1-3 are all band DIFFERENCES: zero-mean locally, so no combination of them
	// can lift a uniformly dark region. That is precisely why NTM 1.0.2 looked like it
	// only touched the highlights. Term 4 is the DC term -- how far this region sits
	// below the frame mean -- and it is what opens up the shadows.
	// Local-exposure reference is G1 (1/4 res), NOT G3 (1/16).
	//
	// At 1/16 a narrow shadow next to a bright surface is already averaged away: the
	// base reads bright, the exposure term sees nothing dark, and the shadow does not
	// open. G1 is four times finer and still smooth enough to be halo-free.
	//
	// G0 (1/2 res) was measured and NOT adopted. It catches the very deepest pixels
	// (+2.18 stops on the 0.0..0.05 output band, 0.1% of pixels) while leaving the
	// 0.05..0.15 band unchanged (+0.0014), and the local correction has no temporal
	// accumulation, so amplifying the darkest 0.1% by two stops would trade a little
	// shadow depth for visible shadow-noise shimmer in motion. Overall metrics were
	// indistinguishable (correlation 0.9647 vs 0.9663).
	const float Exposure = clamp(G1 - NTMO_MeanLogLum(), -3.0f, 3.0f);

	// NOTE: the s_base term -- SBase * (curve(G3) - curve(G0)) -- is deliberately NOT
	// applied. A concave tone curve maps the blurred base systematically HIGHER than the
	// detailed signal, so that term carries a large positive DC and brightens the whole
	// frame no matter what its coefficient does. Measured: with it enabled the local
	// operator lifted the image by +0.11 display luma even at quarter strength, which is
	// the wash-out this build's fix is about. The base compression it was meant to model
	// is already the tone curve's job.
	const float Detail = SMid  * (G1 - G3)
	                   + SHigh * (G0 - G1);

	// Local exposure is a FILL LIGHT, not a bidirectional shift.
	//
	// Two failed iterations are baked into this line:
	//   1) applying the raw (G3 - mean) term in both directions lifted the whole frame
	//      by +0.11..+0.16 display luma and washed the image out, because most of a
	//      normally-exposed scene sits below the frame mean;
	//   2) clamping only the coefficient's sign did not help, because the coefficient was
	//      already negative -- the bias came from the *term*, not the weight.
	// Restricting it to below-mean regions (max(0, -Exposure)) makes it do what the name
	// promises: open the shadows and leave the highlights to the tone curve, whose job
	// compressing those already is.
	const float ShadowLift = max(0.0f, -Exposure) * max(0.0f, -SLow) * NTMOExposureScale * NTMOShadowBoost;

	const float Corr = NTMODetailMix * Detail + ShadowLift;

	// ShadowLift acts on scene luminance (pre-curve); the detail bands act on display
	// values (post-curve).
	const float PreCurve = clamp(ShadowLift, 0.0f, NTMOClampStops);
	const float PostCurve = clamp(NTMODetailMix * Detail, -NTMOClampStops, NTMOClampStops);
	RWNTMOCorrection[DispatchThreadId.xy] = float2(PreCurve, PostCurve);
}

// ---------------------------------------------------------------------------
// Curve temporal smoothing (exponential moving average on the 8 knots).
//
// The network predicts each frame independently from image statistics, so a hard
// content change (camera cut, a light turning on, a bright object entering frame)
// makes the curve jump. On screen that reads as the whole image flashing brighter or
// darker for a few frames. An EMA on the knots fixes it cheaply: the knots are only
// 8 floats, and because the blend is a convex combination, monotonicity is preserved
// exactly -- a blend of two increasing sequences is increasing.
//
// This runs before the LUT bake, so the bake always sees the smoothed curve.
// ---------------------------------------------------------------------------
StructuredBuffer<float> NTMOPrevKnots;
StructuredBuffer<float> NTMONewKnots;
RWStructuredBuffer<float> RWNTMOSmoothedKnots;
float NTMOBlendAlpha;

[numthreads(8, 1, 1)]
void MainCS_BlendKnots(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint i = DispatchThreadId.x;
	if (i >= 8u)
	{
		return;
	}

	const float New = NTMONewKnots[i];
	RWNTMOSmoothedKnots[i] = NTMOBlendAlpha >= 1.0f ? New : lerp(NTMOPrevKnots[i], New, saturate(NTMOBlendAlpha));
	// Only the curve is smoothed, but the downstream operator consumes all 72 values.
	[unroll] for (uint block = 0u; block < 8u; ++block)
	{
		const uint tileBand = 8u + block * 8u + i;
		RWNTMOSmoothedKnots[tileBand] = NTMONewKnots[tileBand];
	}
}
