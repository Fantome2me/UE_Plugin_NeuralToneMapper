#include "/Engine/Private/Common.ush"
#include "NTMOLLFOffsets.ush"
StructuredBuffer<float> Weights;
Texture2D<float4> A;
Texture2D<float4> B;
Texture2D<float4> C;
SamplerState Bi;
StructuredBuffer<float4> Eye;
StructuredBuffer<float> Feat;
StructuredBuffer<float> KV;
RWStructuredBuffer<float> VecOut;
RWTexture2D<float4> ImageOut;
int2 Size;
int2 ASize;
float4 SceneRect;
float4 BloomRect;
float3 Tint;
float BloomAmount;
float3 ReadA(int2 p){return A.Load(int3(clamp(p,0,ASize-1),0)).rgb;}
float3 Source(int2 p){return (ReadA(p));}
float3 Band(int2 p){p=clamp(p,0,ASize-1);return Source(p)-B.SampleLevel(Bi,(p+.5)/ASize,0).rgb;}
float3 Lookup(int table,float3 rgb){
 float3 pos=saturate(rgb)*16;int3 ij=min(int3(pos),15);float3 f=pos-ij;float3 v=0;
 [unroll]for(int z=0;z<2;z++)[unroll]for(int y=0;y<2;y++)[unroll]for(int x=0;x<2;x++){
 int3 k=ij+int3(x,y,z);uint n=W_tables+table*14739+k.z*289+k.y*17+k.x;
 v+=float3(Weights[n],Weights[n+4913],Weights[n+9826])*(x?f.x:1-f.x)*(y?f.y:1-f.y)*(z?f.z:1-f.z);}
 return v;
}
[numthreads(8,8,1)] void Main(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=Size))return;float2 uv=(p+.5)/Size;
#if STAGE==0
 float3 s=A.SampleLevel(Bi,SceneRect.xy+uv*SceneRect.zw,0).rgb*Tint+B.SampleLevel(Bi,BloomRect.xy+uv*BloomRect.zw,0).rgb*BloomAmount;
 s=max(s*Eye[0].x*View.OneOverPreExposure,0); ImageOut[p]=float4(s/(1+s),1);
#elif STAGE==1
 float3 sum=0;int count=0;[unroll]for(int j=0;j<4;j++){int2 q=2*p+int2(j%2,j/2);if(all(q<ASize)){sum+=ReadA(q);count++;}} ImageOut[p]=float4(sum/count,1);
#elif STAGE==2
 float emb[16];[loop]for(int o=0;o<16;o++){float v=Weights[W_embed_bias+o];[unroll]for(int j=0;j<9;j++){int2 q=p+int2(j%3,j/3)-1;if(all(q>=0)&&all(q<Size)){float3 s=sqrt(max(ReadA(q),1.e-8));[unroll]for(int c=0;c<3;c++)v+=s[c]*Weights[W_embed_weight+o*27+c*9+j];}}emb[o]=v;VecOut[(p.y*Size.x+p.x)*16+o]=v;}
#elif STAGE==3
 int2 lo=p*ASize/8,hi=((p+1)*ASize+7)/8;float avg[16];[unroll]for(int c=0;c<16;c++)avg[c]=0;
 for(int y=lo.y;y<hi.y;y++)for(int x=lo.x;x<hi.x;x++)[unroll]for(int c=0;c<16;c++)avg[c]+=Feat[(y*ASize.x+x)*16+c];
 [loop]for(int o=0;o<32;o++){float v=Weights[W_attend_in_proj_bias+16+o];[unroll]for(int c=0;c<16;c++)v+=avg[c]/((hi.x-lo.x)*(hi.y-lo.y))*Weights[W_attend_in_proj_weight+(o+16)*16+c];VecOut[(p.y*8+p.x)*32+o]=v;}
#elif STAGE==4
 float e[16],qv[16],att[16];[unroll]for(int i=0;i<16;i++)e[i]=Feat[(p.y*Size.x+p.x)*16+i];
 [loop]for(int o=0;o<16;o++){float v=Weights[W_attend_in_proj_bias+o];[unroll]for(int i=0;i<16;i++)v+=e[i]*Weights[W_attend_in_proj_weight+o*16+i];qv[o]=v;att[o]=0;}
 [unroll]for(int h=0;h<2;h++){float m=-1e20,den=0;[loop]for(int t=0;t<64;t++){float dotv=0;[unroll]for(int d=0;d<8;d++)dotv+=qv[h*8+d]*KV[t*32+h*8+d];float s=dotv*.35355339,nm=max(s,m),a=exp(m-nm),b=exp(s-nm);den=den*a+b;[unroll]for(int d=0;d<8;d++)att[h*8+d]=att[h*8+d]*a+b*KV[t*32+16+h*8+d];m=nm;}[unroll]for(int d=0;d<8;d++)att[h*8+d]/=den;}
 float3 w=0;[loop]for(int o=0;o<16;o++){float v=e[o]+Weights[W_attend_out_proj_bias+o];[unroll]for(int i=0;i<16;i++)v+=att[i]*Weights[W_attend_out_proj_weight+o*16+i];[unroll]for(int c=0;c<3;c++)w[c]+=v*Weights[W_weights_weight+c*16+o];}
 [unroll]for(int c=0;c<3;c++)w[c]+=Weights[W_weights_bias+c];w=exp(w-max(w.x,max(w.y,w.z)));w/=dot(w,1);float3 src=ReadA(p);ImageOut[p]=float4(w.x*Lookup(0,src)+w.y*Lookup(1,src)+w.z*Lookup(2,src),1);
#elif STAGE==5
 float vals[63];[unroll]for(int j=0;j<9;j++){int2 q=p+int2(j%3,j/3)-1;bool ok=all(q>=0)&&all(q<Size);float3 s=ReadA(q),y=C.SampleLevel(Bi,(q+.5)/Size,0).rgb;float edge=dot(abs(Band(q)),1./3.);[unroll]for(int c=0;c<3;c++){vals[c*9+j]=ok?s[c]:0;vals[(c+3)*9+j]=ok?y[c]:0;}vals[54+j]=ok?edge:0;}
 float2 par=float2(Weights[W_detail_2_bias],Weights[W_detail_2_bias+1]);[loop]for(int o=0;o<12;o++){float v=Weights[W_detail_0_bias+o];[unroll]for(int i=0;i<63;i++)v+=vals[i]*Weights[W_detail_0_weight+o*63+i];par+=max(v,0)*float2(Weights[W_detail_2_weight+o],Weights[W_detail_2_weight+12+o]);}
 float3 band=Band(p);float sigma=.002+.2/(1+exp(-par.y));ImageOut[p]=float4(C.SampleLevel(Bi,uv,0).rgb+band*(1+.9*tanh(par.x)*exp(-dot(abs(band),1./3.)/sigma)),1);
#endif
}
