//
// Unreal's colour grading, ported so the plugin can reproduce it.
//
// WHY THIS EXISTS
// ---------------
// The plugin replaces EPostProcessingPass::ReplacingTonemapper. Unreal skips
// AddCombineLUTPass along with the tonemapper pass, and PostProcessCombineLUTs.usf is
// where ALL of this happens before Unreal's own film curve:
//
//     WorkingLinear
//       -> WhiteBalance                      (unused here; the project leaves it neutral)
//       -> ExpandGamut        (ABSOLUTELY CENTRAL, default 1.0)
//       -> ColorCorrectAll    (saturation/contrast/gamma/gain/offset, per zone)
//       -> film curve
//
// 1.0.4 applied none of it. Measured against Unreal on a night-sky scene that is a
// real, visible loss: mean HSV saturation -21.5%, mean chroma -14.9%, and -48% chroma
// on the most saturated 0.6% of pixels. That is what "the image went grey" means
// numerically, and ExpandGamut - on by default at a strength of 1.0 - is most of it.
//
// The maths below is a line-for-line port of PostProcessCombineLUTs.usf so the result
// matches Unreal's instead of merely looking plausible.
//
// COST
// ----
// All of this runs inside the LUT bake, which happens once per N frames on a 33^3
// grid (35 937 texels). The per-pixel cost is unchanged: still one 3D texture fetch.

#pragma once

// AP1 luminance weights, straight from ACESCommon.ush (AP1_2_XYZ_MAT column 1).
static const float3 NTMO_AP1_RGB2Y = float3(0.2722287168f, 0.6740817658f, 0.0536895174f);

// ---------------------------------------------------------------------------
// ColorCorrect - Nuke-style lift/gamma/gain in AP1.
// ---------------------------------------------------------------------------
// Each vector's .w is the master weight, matching FPostProcessSettings. With every
// parameter at its default (1,1,1,1) / (0,0,0,0) this is the identity, so enabling it
// cannot change an image that has no grading - it only restores grading that exists.
float3 NTMO_ColorCorrect(
	float3 WorkingColor,
	float4 ColorSaturation,
	float4 ColorContrast,
	float4 ColorGamma,
	float4 ColorGain,
	float4 ColorOffset)
{
	// Saturation around the AP1 luma axis.
	float Luma = dot(WorkingColor, NTMO_AP1_RGB2Y);
	WorkingColor = max(0, lerp(Luma.xxx, WorkingColor, ColorSaturation.xyz * ColorSaturation.w));

	// Contrast. Unreal pivots around 0.18 (mid grey), not around 0.5 - using 0.5 would
	// shift the whole image, which is why this is copied rather than re-derived.
	WorkingColor = pow(WorkingColor * (1.0f / 0.18f), ColorContrast.xyz * ColorContrast.w) * 0.18f;

	// Gamma.
	WorkingColor = pow(WorkingColor, 1.0f / max(ColorGamma.xyz * ColorGamma.w, 1.0e-4f));

	// Gain and offset.
	WorkingColor = WorkingColor * (ColorGain.xyz * ColorGain.w) + (ColorOffset.xyz + ColorOffset.w);

	return WorkingColor;
}

// ---------------------------------------------------------------------------
// ColorCorrectAll - the shadow / midtone / highlight split.
// ---------------------------------------------------------------------------
// Zones are blended by luma with the same smoothsteps Unreal uses, so a project that
// grades only the shadows behaves identically here.
float3 NTMO_ColorCorrectAll(
	float3 WorkingColor,

	float4 ColorSaturation, float4 ColorContrast, float4 ColorGamma, float4 ColorGain, float4 ColorOffset,

	float4 ColorSaturationShadows, float4 ColorContrastShadows, float4 ColorGammaShadows,
	float4 ColorGainShadows, float4 ColorOffsetShadows,

	float4 ColorSaturationMidtones, float4 ColorContrastMidtones, float4 ColorGammaMidtones,
	float4 ColorGainMidtones, float4 ColorOffsetMidtones,

	float4 ColorSaturationHighlights, float4 ColorContrastHighlights, float4 ColorGammaHighlights,
	float4 ColorGainHighlights, float4 ColorOffsetHighlights,

	float ColorCorrectionShadowsMax,
	float ColorCorrectionHighlightsMin,
	float ColorCorrectionHighlightsMax)
{
	float Luma = dot(WorkingColor, NTMO_AP1_RGB2Y);

	float3 CCColorShadows = NTMO_ColorCorrect(WorkingColor,
		ColorSaturationShadows * ColorSaturation,
		ColorContrastShadows * ColorContrast,
		ColorGammaShadows * ColorGamma,
		ColorGainShadows * ColorGain,
		ColorOffsetShadows + ColorOffset);
	float CCWeightShadows = 1 - smoothstep(0, ColorCorrectionShadowsMax, Luma);

	float3 CCColorHighlights = NTMO_ColorCorrect(WorkingColor,
		ColorSaturationHighlights * ColorSaturation,
		ColorContrastHighlights * ColorContrast,
		ColorGammaHighlights * ColorGamma,
		ColorGainHighlights * ColorGain,
		ColorOffsetHighlights + ColorOffset);
	float CCWeightHighlights = smoothstep(ColorCorrectionHighlightsMin, ColorCorrectionHighlightsMax, Luma);

	float3 CCColorMidtones = NTMO_ColorCorrect(WorkingColor,
		ColorSaturationMidtones * ColorSaturation,
		ColorContrastMidtones * ColorContrast,
		ColorGammaMidtones * ColorGamma,
		ColorGainMidtones * ColorGain,
		ColorOffsetMidtones + ColorOffset);
	float CCWeightMidtones = 1 - CCWeightShadows - CCWeightHighlights;

	return CCColorShadows * CCWeightShadows
		+ CCColorMidtones * CCWeightMidtones
		+ CCColorHighlights * CCWeightHighlights;
}

// ---------------------------------------------------------------------------
// ExpandGamut - the piece 1.0.4 was missing.
// ---------------------------------------------------------------------------
// Unreal's default is 1.0, and it is applied BEFORE the tone curve. It pushes bright
// saturated colours out toward a gamut between P3 and AP1, which is what stops a tone
// curve from rendering them as pastel.
//
// ExpandAmount is deliberately gated twice:
//   (1 - exp2(-4 * ChromaDistSqr))              -> 0 for anything already neutral
//   (1 - exp2(-4 * ExpandGamut * LumaAP1^2))    -> 0 for anything already dark
// so greys and shadows pass through untouched and only bright, saturated pixels move.
// That gating is why this cannot simply be replaced by a global saturation boost.
float3 NTMO_ExpandGamut(float3 ColorAP1, float ExpandGamut, float3x3 ExpandMat)
{
	if (ExpandGamut <= 0.0f)
	{
		return ColorAP1;
	}

	float LumaAP1 = dot(ColorAP1, NTMO_AP1_RGB2Y);
	float3 ChromaAP1 = ColorAP1 / max(LumaAP1, 1.0e-5f);

	float ChromaDistSqr = dot(ChromaAP1 - 1, ChromaAP1 - 1);
	float ExpandAmount = (1 - exp2(-4 * ChromaDistSqr))
		* (1 - exp2(-4 * ExpandGamut * LumaAP1 * LumaAP1));

	float3 ColorExpand = mul(ExpandMat, ColorAP1);
	return lerp(ColorAP1, ColorExpand, ExpandAmount);
}

// ---------------------------------------------------------------------------
// Per-channel tone curve, in AP1 - Unreal's own hue behaviour.
// ---------------------------------------------------------------------------
// Unreal's FilmToneMap compresses R, G and B independently. That is precisely why
// ACES-derived curves shift hue on bright saturated colours (the "notorious six"), and
// it is also why Unreal's sky reads blue-violet where a hue-preserving operator reads
// cyan. The plugin's default MaxRGB operator deliberately preserves hue, which is a
// different look - not the same look computed differently.
//
// This is the Unreal-compatible alternative: the same learned curve, applied per
// channel, so the hue drift matches Unreal's instead of being suppressed.
//
// The curve itself is unchanged (same knots, same Fritsch-Carlson evaluation); only the
// formulation differs. MaxRGB maps max(RGB) and scales the rest by one ratio; this maps
// each channel on its own.
float3 NTMO_ToneMapPerChannelAP1(
	float3 ColorAP1,
	FNTMOKnots K,
	float HighlightDesat,
	float BlackLift,
	float Saturation,
	float GamutCompress,
	float MaxNits,
	float MinNits)
{
	const float PeakLinear = max(MaxNits * 0.01f, 1.0e-4f);
	const float FloorLinear = MinNits * 0.01f;
	const float LogFloor = log2(max(FloorLinear, 1.0e-8f));
	const float LogPeak = log2(PeakLinear);

	// Per channel: log2 -> curve -> exp2, then the physical clamp. Values at or below
	// the floor stay at the floor rather than going to log2(0).
	float3 OutColor;
	[unroll]
	for (int c = 0; c < 3; ++c)
	{
		const float C = ColorAP1[c];
		if (C <= 1.0e-8f)
		{
			OutColor[c] = BlackLift;
			continue;
		}
		const float OutLog2 = clamp(NTMO_EvalCurveLog2(log2(C), K), LogFloor, LogPeak);
		OutColor[c] = clamp(exp2(OutLog2), FloorLinear, PeakLinear);
	}

	const float Lum = dot(OutColor, NTMO_AP1_RGB2Y);

	// Same highlight desaturation ramp as the MaxRGB path so the two stay comparable.
	const float PeakNits = max(MaxNits, 1.0f);
	const float DesatStart = 0.60f * PeakNits;
	const float DesatSpan = max(PeakNits - DesatStart, 1.0f);
	const float PeakOut = max(OutColor.r, max(OutColor.g, OutColor.b));
	const float DesatAmount = saturate(((PeakOut * 100.0f) - DesatStart) / DesatSpan) * HighlightDesat;
	OutColor = lerp(OutColor, float3(Lum, Lum, Lum), saturate(DesatAmount));

	if (GamutCompress > 0.0f)
	{
		OutColor = lerp(OutColor, float3(Lum, Lum, Lum), saturate(GamutCompress));
	}

	if (abs(Saturation - 1.0f) > 1.0e-4f)
	{
		OutColor = lerp(float3(Lum, Lum, Lum), OutColor, Saturation);
	}

	return max(OutColor + BlackLift, 0.0f);
}
// ---------------------------------------------------------------------------
// Curve reshape - 1.0.7
// ---------------------------------------------------------------------------
// The predicted curve is internally consistent but sits low with a flat top. Measured
// on the night-sky project: 18% grey -> 0.152 where Unreal's ACES puts it at 0.267
// (-0.81 stops), 100 nit -> 0.584 where ACES puts it at 0.804, peak at 90 nit on a
// 100 nit panel, shoulder slope 0.03 (400 nit and 1000 nit landed on the same value).
// That is the reported symptom: richer colour, darker picture, no highlight range.
//
// Two monotone remaps, both functions of the OUTPUT value, neither touching the black
// end and neither requiring a different model:
//   1. a bell lift centred on the curve's own 18% grey output;
//   2. a shoulder fill that stretches everything above that toward the real peak.
void NTMO_ReshapeCurve(
	inout FNTMOKnots K,
	float MidGreyStops,
	float MidGreyWidth,
	float PeakFill,
	float LogPeak,
	float LogFloor)
{
	if (MidGreyStops == 0.0f && PeakFill <= 0.0f)
	{
		return;
	}

	float V[8] = { K.K01.x, K.K01.y, K.K01.z, K.K01.w,
	               K.K23.x, K.K23.y, K.K23.z, K.K23.w };

	const float MidOut = NTMO_EvalCurveLog2(log2(0.18f), K);
	const float Width = max(MidGreyWidth, 0.25f);

	float Out[8];
	[unroll]
	for (int i = 0; i < 8; ++i)
	{
		float O = V[i];

		const float W = exp(-(O - MidOut) * (O - MidOut) / (Width * Width));
		O += MidGreyStops * W;

		const float S = saturate((O - MidOut) / max(LogPeak - MidOut, 1.0e-3f));
		O += (LogPeak - O) * PeakFill * S;

		Out[i] = clamp(O, LogFloor, LogPeak);
	}

	[unroll]
	for (int j = 1; j < 8; ++j)
	{
		Out[j] = max(Out[j], Out[j - 1]);
	}

	K.K01 = float4(Out[0], Out[1], Out[2], Out[3]);
	K.K23 = float4(Out[4], Out[5], Out[6], Out[7]);
}

/** Anchor HDR 18% scene gray to the display's configured diffuse-gray level. */
float3 NTMO_AnchorHDRMidGrey(
	float3 Color,
	FNTMOKnots K,
	float MidGreyNits,
	float PeakLinear,
	float FloorLinear)
{
	if (MidGreyNits <= 0.0f)
	{
		return Color;
	}

	const float Lum = dot(max(Color, 0.0f), float3(0.2126f, 0.7152f, 0.0722f));
	if (Lum <= 1.0e-8f)
	{
		return Color;
	}

	const float LogFloor = log2(max(FloorLinear, 1.0e-8f));
	const float LogPeak = log2(max(PeakLinear, FloorLinear + 1.0e-6f));
	const float RawMid = clamp(NTMO_EvalCurveLog2(log2(0.18f), K), LogFloor, LogPeak);
	const float TargetMid = clamp(log2(max(MidGreyNits * 0.01f, FloorLinear)), LogFloor, LogPeak);
	const float LogLum = clamp(log2(Lum), LogFloor, LogPeak);

	float AnchoredLogLum;
	if (LogLum <= RawMid)
	{
		const float T = saturate((LogLum - LogFloor) / max(RawMid - LogFloor, 1.0e-4f));
		AnchoredLogLum = lerp(LogFloor, TargetMid, T);
	}
	else
	{
		const float T = saturate((LogLum - RawMid) / max(LogPeak - RawMid, 1.0e-4f));
		AnchoredLogLum = lerp(TargetMid, LogPeak, T);
	}

	return Color * exp2(AnchoredLogLum - LogLum);
}

// ---------------------------------------------------------------------------
// Chroma compensation - trade lightness for colour instead of losing both.
// ---------------------------------------------------------------------------
// Compressing luminance costs colourfulness: in a perceptually uniform space the chroma
// has to rise as lightness falls for a colour to keep looking as colourful (the Hunt
// effect; HDR work such as Shen et al., "Scaling Lightness and Chroma for Highlight
// Stimuli in HDR Scenes", treats the two as a coupled pair, not as luminance plus a
// fixed saturation).
//
// So give chroma back where the display has room: more toward black, nothing at the
// peak. That is what makes a compressed image read as deep instead of washed out, and
// it is deliberately NOT a global saturation slider, which would also inflate the
// highlights that already sit at the peak.
float3 NTMO_ChromaCompensate(float3 Color, float Amount, float PeakLinear)
{
	if (Amount <= 0.0f)
	{
		return Color;
	}

	const float Lum = dot(Color, float3(0.2126f, 0.7152f, 0.0722f));
	const float Room = saturate(1.0f - Lum / max(PeakLinear, 1.0e-4f));
	return max(Lum + (Color - Lum) * (1.0f + Amount * Room), 0.0f);
}
